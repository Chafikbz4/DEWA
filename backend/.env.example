# ---------------------------------------------------------------------------
# DEWA API configuration. Copy to .env and fill in. Validated at boot
# (src/config/env.validation.ts) – the app refuses to start if anything is wrong.
# Neon: `neon env pull` writes DATABASE_URL / DATABASE_URL_UNPOOLED to .env.local.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Database (pooled URL for the app, direct URL for migrations)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_MAX=10

# Optional – enables shared rate-limit storage across instances
REDIS_URL=

# Comma-separated CORS allowlist
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false

# Secrets – generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
HASH_PEPPER=

JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# OTP & lockout
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Rate limits
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_IP_PER_MINUTE=20
RATE_LIMIT_AUTH_ACCOUNT_PER_15_MIN=10

# Providers (console = dev mock, refused when NODE_ENV=production)
SMS_PROVIDER=console
EMAIL_PROVIDER=console

STAFF_INVITATION_TTL_DAYS=7
CONSENT_TERMS_VERSION=2026-10
CONSENT_PRIVACY_VERSION=2026-10
SWAGGER_ENABLED=true

# Seed (npm run db:seed) – super admin is created only if both are set
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
